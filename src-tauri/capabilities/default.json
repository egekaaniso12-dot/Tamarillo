{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Tamarillo ana pencere yetkileri",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true
        },
        {
          "name": "binaries/ffprobe",
          "sidecar": true
        },
        {
          "name": "binaries/yt-dlp",
          "sidecar": true
        }
      ]
    },
    "shell:allow-kill",
    "dialog:allow-open"
  ]
}
