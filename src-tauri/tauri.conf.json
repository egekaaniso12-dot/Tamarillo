{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tamarillo",
  "version": "0.1.0",
  "identifier": "com.egehsmedya.tamarillo",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Tamarillo", "width": 1180, "height": 760, "minWidth": 920, "minHeight": 640 }], "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'" } },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "İçerik üreticileri için masaüstü araç seti",
    "longDescription": "Medya dönüştürme ve içerik üretim araçları. Copyright EgeHS Medya 2026 - 2027",
    "copyright": "Copyright EgeHS Medya 2026 - 2027",
    "targets": ["nsis"],
    "windows": { "nsis": { "installMode": "both", "languages": ["Turkish", "English"], "displayLanguageSelector": false, "startMenuFolder": "Tamarillo" } }
  }
}
